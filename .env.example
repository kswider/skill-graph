# Copy to .env.local for local development. On Vercel, the Neon integration sets the database variables.

# Local Postgres in Docker (`pnpm db:up`, see scripts/db-up.mts)
DATABASE_URL=postgres://skillgraph:skillgraph@localhost:5433/skillgraph

# Sign-in (src/lib/auth.ts). Locally and on previews the demo sign-in works without any of these.
# Required in production: a random secret (openssl rand -base64 32) and the Microsoft (Entra ID) app registration.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://your-production-domain
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=   # your tenant id; "common" (the default) also allows personal Microsoft accounts

# Skips the sign-in page and signs everyone in as this demo person (only where demo sign-in is on). /sign-in?manual=1 still shows the picker.
# DEFAULT_DEMO_EMAIL=sky.bennett@example.com
